          <p class="feature-desc">
            Automated Google OAuth synchronization. Confirmed slots instantly create Google Meet conference links and populate attendees' Google Calendars with zero manual configuration.
          </p>
        </div>

        <!-- Feature 3: Smart Slots -->
        <div class="landing-feature-card">
          <div class="feature-icon-box feat-calendar">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="feature-badge">Conflict Prevention</div>
          <h3 class="feature-title">Intelligent Slot Scheduling</h3>
          <p class="feature-desc">
            Multi-slot batch generation, automated duration calculations, IST timezone enforcement, and robust double-booking prevention ensuring reliable scheduling across large cohorts.
          </p>
        </div>

        <!-- Feature 4: Scorecards -->
        <div class="landing-feature-card">
          <div class="feature-icon-box feat-rubric">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <div class="feature-badge">Calibrated Metrics</div>
          <h3 class="feature-title">Instant Rubric Scorecards</h3>
          <p class="feature-desc">
            Evaluators submit criterion marks (0-10) with immediate aggregate total calculation (30 pts max) and automated grading (Grade A+, A, B, C, F) visible in the candidate's scorecard.
          </p>
        </div>

        <!-- Feature 5: Cohort Analytics -->
        <div class="landing-feature-card">
          <div class="feature-icon-box feat-admin">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M18 20V10"/>
              <path d="M12 20V4"/>
              <path d="M6 20v-6"/>
            </svg>
          </div>
          <div class="feature-badge">Admin Controls</div>
          <h3 class="feature-title">Cohort Placement Analytics</h3>
          <p class="feature-desc">
            Placement cell dashboards tracking batch completion rates, booking bottlenecks, attendance rollups, and one-click CSV report exports for campus recruitment drives.
          </p>
        </div>

        <!-- Feature 6: Portfolio Hub -->
        <div class="landing-feature-card">
          <div class="feature-icon-box feat-profile">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <div class="feature-badge">Candidate Hub</div>
          <h3 class="feature-title">Resume &amp; Dossier Integration</h3>
          <p class="feature-desc">
            Centralized candidate profile profiles featuring verified resume links, branch and squad filtering, historical session archives, and candidate feedback mechanisms.
          </p>
        </div>
      </div>
    </div>
  </section>

