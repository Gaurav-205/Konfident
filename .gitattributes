# Normalize line endings: store everything as LF in the repo, check out LF.
# This clears the repo-wide CRLF/LF churn that showed every file as modified.
* text=auto eol=lf

# Explicit text types
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.ejs     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.conf    text eol=lf

# Binary assets — never touch
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.pdf     binary

# Keep lockfile diffs collapsed in PR review
package-lock.json  -diff linguist-generated
